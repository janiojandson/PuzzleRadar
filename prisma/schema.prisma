// ============================================
// 🧩 PuzzleRadar — Prisma Schema (Fleet, Intelligence Hub & Multi-Chain)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT / ORGANIZAÇÃO ───
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  pools       Pool[]
  apiKeys     ApiKey[]

  @@map("organizations")
}

// ─── MEMBROS ───
model Member {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole        @default(MEMBER)
  joinedAt       DateTime          @default(now())

  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  contributions  Contribution[]

  @@unique([userId, organizationId])
  @@map("members")
}

enum MemberRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

// ─── USUÁRIOS (Pessoas que gerenciam frotas) ───
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  username      String     @unique
  passwordHash  String
  displayName   String?
  role          UserRole   @default(USER)
  workerToken   String?    @unique
  activePlan    String     @default("FREE_COMMUNITY")
  avatarUrl     String?
  gpuModel      String?    // ex: "RTX 4090", "Tesla T4 Farm"
  cpuModel      String?
  hasGpu        Boolean    @default(false)
  totalShares   Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   Member[]
  contributions Contribution[]
  walletAddresses WalletAddress[]
  assignedRanges  Range[]         @relation("AssignedRanges")
  workerTokens    WorkerToken[]
  fleetNodes      FleetNode[]
  discoveryHints  DiscoveryHint[]
  distinguishedPoints DistinguishedPoint[]
  payoutShares    PoolSharePayout[]

  @@map("users")
}

enum UserRole {
  USER
  SUBSCRIBER
  ADMIN
}

// ─── FLEET NODES (Gerenciamento de Frotas de Máquinas e Colabs) ───
model FleetNode {
  id               String      @id @default(cuid())
  userId           String?
  nodeToken        String      @unique
  name             String      // ex: "colab-conta-01", "rig-rtx4090-sp"
  accountTag       String?     // ex: "google-conta-principal", "conta-02-janio"
  hardwareType     String      @default("GPU_TESLA_T4") // GPU_TESLA_T4, GPU_RTX, CPU
  gpuModel         String?     @default("NVIDIA Tesla T4")
  vramGB           Int?        @default(16)
  ipAddress        String?
  currentHashrate  Float       @default(0) // chaves por segundo
  totalKeysChecked Float       @default(0)
  totalShares      Float       @default(0)
  currentTaskId    String?
  status           FleetStatus @default(IDLE)
  lastPing         DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User?       @relation(fields: [userId], references: [id])

  @@map("fleet_nodes")
}

enum FleetStatus {
  IDLE
  MINING
  BENCHMARKING
  OFFLINE
  ERROR
}

// ─── DISCOVERY HINTS (Mural Central de Inteligência e Pistas Criptográficas) ───
model DiscoveryHint {
  id             String     @id @default(cuid())
  puzzleId       String?
  userId         String?
  title          String     // ex: "Descoberta de 8 palavras da semente ETH #101"
  hintType       HintType   @default(SEED_WORDS)
  fragment       String?    // Hex ou texto do fragmento
  seedWords      String?    // Palavras BIP39 conhecidas separadas por espaço
  knownBitsCount Int?       @default(0)
  confidence     Float      @default(100.0) // Confiança %
  authorName     String     @default("Cypherpunk Miner")
  isVerified     Boolean    @default(true)
  metadata       Json?
  createdAt      DateTime   @default(now())

  user           User?      @relation(fields: [userId], references: [id])
  puzzle         Puzzle?    @relation(fields: [puzzleId], references: [id])

  @@map("discovery_hints")
}

enum HintType {
  SEED_WORDS
  MASK_PREFIX
  MASK_SUFFIX
  PUBLIC_KEY
  BIT_PATTERN
}

// ─── PUBLIC RANGE IMPORTS (Registro de Ingestão de Alianças Públicas) ───
model PublicRangeImport {
  id              String       @id @default(cuid())
  puzzleId        String
  sourceName      String       // ex: "bitcoinpuzzles.io", "BTC Challenge Pool"
  sourceUrl       String?
  rangesCount     Int          @default(0)
  prunedPercent   Float        @default(0)
  syncedToSheets  Boolean      @default(true)
  spreadsheetId   String?
  importedAt      DateTime     @default(now())

  @@map("public_range_imports")
}

// ─── WORKER TOKENS ───
model WorkerToken {
  id          String   @id @default(cuid())
  userId      String?
  token       String   @unique
  name        String   @default("worker-node")
  hardware    String   @default("GPU")
  gpuModel    String?
  cpuModel    String?
  lastSeenAt  DateTime @default(now())
  totalKeys   Float    @default(0)
  totalShares Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@map("worker_tokens")
}

// ─── CARTEIRAS ───
model WalletAddress {
  id        String @id @default(cuid())
  userId    String
  chain     ChainType
  address   String
  isPrimary Boolean @default(false)

  user      User   @relation(fields: [userId], references: [id])

  @@unique([userId, chain, address])
  @@map("wallet_addresses")
}

enum ChainType {
  BTC
  ETH
  SOL
  OTHER
}

// ─── PUZZLES / DESAFIOS MULTI-MOEDAS ───
model Puzzle {
  id               String          @id @default(cuid())
  title            String
  description      String?
  chain            ChainType       @default(BTC)
  puzzleNumber     Int?
  targetAddress    String?
  targetPublicKey  String?
  bitRange         Int
  rangeStart       String
  rangeEnd         String
  prizeAmount      Float
  prizeCurrency    String          @default("BTC")
  difficultyScore  Float
  difficultyLabel  DifficultyLabel
  hints            Json?
  effectiveBits    Float?
  entropyReduction Float?
  publicKeyExposed Boolean         @default(false)
  status           PuzzleStatus    @default(ACTIVE)
  sourceUrl        String?
  sourceName       String?
  solvedBy         String?
  solvedAt         DateTime?
  hash160          String?          // hash160 derivado do endereço (RIPEMD160(SHA256(pubKey)))
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  pools            Pool[]
  ranges           Range[]         @relation("PuzzleRanges")
  contributions    Contribution[]
  discoveryHints   DiscoveryHint[]
  distinguishedPoints DistinguishedPoint[]
  payoutShares     PoolSharePayout[]

  @@map("puzzles")
}

enum DifficultyLabel {
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum PuzzleStatus {
  ACTIVE
  IN_PROGRESS
  SOLVED
  EXPIRED
  ARCHIVED
  INVALID_KEY_PAIR
  QUARANTINED
}

// ─── POOLS COLABORATIVOS ───
model Pool {
  id              String       @id @default(cuid())
  organizationId  String
  puzzleId        String
  name            String
  description     String?
  strategy        PoolStrategy @default(RANGE_SPLIT)
  totalRanges     Int          @default(0)
  completedRanges Int          @default(0)
  progressPercent Float        @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  puzzle          Puzzle       @relation(fields: [puzzleId], references: [id])
  ranges          Range[]
  contributions   Contribution[]

  @@map("pools")
}

enum PoolStrategy {
  RANGE_SPLIT
  RANDOM_SAMPLING
  KANGAROO
  BSGS_ECDSA
}

// ─── RANGES DE BUSCA ───
model Range {
  id              String          @id @default(cuid())
  poolId          String
  puzzleId        String?
  assigneeId      String?
  chunkIndex      Int             @default(0)
  rangeStart      String
  rangeEnd        String
  status          RangeStatus     @default(PENDING)
  isPruned        Boolean         @default(false)
  prunedReason    String?
  keysChecked     Float           @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  result          RangeResult     @default(NOT_FOUND)
  foundPrivateKey String?
  priorityScore   Int             @default(50)  // Score de prioridade do lote (0-1000)
  filterApplied   String?                        // Filtros matemáticos aplicados
  progressPct     Float           @default(0)   // Percentual do lote concluído
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  pool            Pool            @relation(fields: [poolId], references: [id])
  puzzle          Puzzle?         @relation(fields: [puzzleId], references: [id], name: "PuzzleRanges")
  assignee        User?           @relation(fields: [assigneeId], references: [id], name: "AssignedRanges")
  contribution    Contribution?

  @@map("ranges")
}

enum RangeStatus {
  PENDING
  ASSIGNED
  RUNNING
  COMPLETED
  PRUNED
  FAILED
  EXPIRED
}

enum RangeResult {
  NOT_FOUND
  FOUND
  ERROR
}

// ─── CONTRIBUIÇÕES ───
model Contribution {
  id              String   @id @default(cuid())
  userId          String
  poolId          String
  puzzleId        String?
  rangeId         String?  @unique
  keysChecked     Float
  computeHours    Float
  gpuHours        Float    @default(0)
  cpuHours        Float    @default(0)
  shares          Float
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  pool            Pool     @relation(fields: [poolId], references: [id])
  range           Range?   @relation(fields: [rangeId], references: [id])
  puzzle          Puzzle?  @relation(fields: [puzzleId], references: [id])
  member          Member?  @relation(fields: [memberId], references: [id])
  memberId        String?

  @@map("contributions")
}

// ─── API KEYS ───
model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  key             String       @unique
  name            String
  permissions     String       @default("worker")
  isActive        Boolean      @default(true)
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@map("api_keys")
}

// ─── LOGS DE ATIVIDADE & AUDITORIA CORPORATIVA ───
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model AuditLog {
  id            String   @id @default(uuid())
  eventCategory String   // "AUTH", "MEV_RESCUE", "QUARANTINE", "ON_CHAIN_ALERT", "BATCH_SYNC", "HONEYPOT"
  severity      String   // "INFO", "WARNING", "CRITICAL"
  details       String   // Descrição textual ou JSON
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([eventCategory, createdAt])
  @@map("audit_logs")
}

// ─── PROOF-OF-SHARE & DISTINGUISHED POINTS (POLLARD'S KANGAROO) ───
model DistinguishedPoint {
  id              String   @id @default(uuid())
  puzzleId        String
  userId          String
  xCoordHex       String   // Coordenada X que colide
  yCoordHex       String   // Coordenada Y
  stepDistanceHex String   // Distância acumulada d
  isTameKangaroo  Boolean  @default(false)
  walkSeed        String?  // Semente para reproduzir a caminhada (debug)
  expiresAt       DateTime? // TTL de 24h — DPs órfãos são limpos pelo cron
  createdAt       DateTime @default(now())

  puzzle          Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([puzzleId, xCoordHex])
  @@index([userId])
  @@map("distinguished_points")
}

model PoolSharePayout {
  id                 String   @id @default(uuid())
  userId             String
  puzzleId           String
  sharesContributed  BigInt   @default(0)
  percentageClaim    Float    @default(0.0)
  amountUsdEstimated Float    @default(0.0)
  isDistributed      Boolean  @default(false)
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle             Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([userId, puzzleId])
  @@map("pool_share_payouts")
}