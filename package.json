{
  "name": "puzzleradar",
  "version": "4.0.0",
  "description": "SaaS Colaborativo para Resolução de Desafios Criptográficos e Redução de Entropia",
  "private": true,
  "main": "src/server/index.js",
  "scripts": {
    "dev": "node src/server/index.js",
    "dev:worker": "node src/workers/worker.js",
    "dev:kangaroo:tame": "WALK_TYPE=tame node src/workers/kangarooWorker.js",
    "dev:kangaroo:wild": "WALK_TYPE=wild node src/workers/kangarooWorker.js",
    "dev:kangaroo:mobile": "MAX_STEPS=10000 node src/workers/kangarooWorker.js",
    "build": "npx prisma generate",
    "start": "node src/server/index.js",
    "test": "node tests/masterValidation.test.js && node tests/telemetryStream.test.js && node tests/difficultyEngine.test.js && node tests/importHistory.test.js && node tests/e2eWorkerFlow.test.js && node tests/v3Scale.test.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:validate": "npx prisma validate",
    "kangaroo:cleanup": "node -e \"require('./src/lib/kangarooManager').cleanupOrphanDPs().then(r => console.log('Cleaned:', r))\""
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "prisma": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}