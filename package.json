{
  "name": "puzzleradar",
  "version": "2.0.0",
  "description": "SaaS Colaborativo para Resolução de Desafios Criptográficos e Redução de Entropia",
  "private": true,
  "main": "src/server/index.js",
  "scripts": {
    "dev": "node src/server/index.js",
    "dev:worker": "node src/workers/worker.js",
