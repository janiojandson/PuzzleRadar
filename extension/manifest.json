{
  "manifest_version": 3,
  "name": "PuzzleRadar Kangaroo Worker",
  "version": "4.0.0",
  "description": "Nó de Mineração e Extensão do Navegador para Pollard Kangaroo & 1000 BTC",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
