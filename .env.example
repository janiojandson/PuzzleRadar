# ============================================
# 🧩 PuzzleRadar — Variáveis de Ambiente
# ============================================

# DATABASE
DATABASE_URL=postgresql://puzzleradar:puzzleradar@localhost:5432/puzzleradar

# REDIS (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-strong-secret-in-production
JWT_EXPIRES_IN=24h

# APP
PORT=3010
NODE_ENV=development

# RAILWAY (auto-deploy)
RAILWAY_PROJECT_ID=
RAILWAY_TOKEN=